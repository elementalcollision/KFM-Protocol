# Application Settings
APP_ENV=development
PROJECT_NAME="KFM Agent Registry Service"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=kfm_registry
POSTGRES_PORT=5432
# Uncomment and modify if you want to set the database URI directly
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@localhost:5432/kfm_registry

# JWT Settings
SECRET_KEY=your-secret-key-for-jwt-CHANGE-ME-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Optional: Future K8s Deployment Settings
# SECRETS_DIR=/etc/secrets 