# Basic Service Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Kubernetes (Optional - for local development outside cluster)
# KUBE_CONFIG_PATH=~/.kube/config

# Observability
OTEL_TRACE_ENABLED=true
# OTLP_ENDPOINT=http://localhost:4318/v1/traces # If running Jaeger/OTel locally

# Config Source (Example: Path to local file for dev)
# CONFIG_SOURCE_URL=
CONFIG_QUOTA_FILE=./config/resource_quotas.yaml # Example path relative to service root

# Messaging / Event Bus
# RABBITMQ_URL=amqp://user:password@rabbitmq-service.kfm-infra.svc.cluster.local:5672/
# KFM_EVENT_EXCHANGE=kfm_events
# RESOURCE_EVENT_QUEUE=resource_manager_queue
# RESOURCE_EVENT_ROUTING_KEY=agent.state.# 