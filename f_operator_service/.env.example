# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME="KFM F Operator Service"
API_V1_STR=/api/v1

# Security Settings
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_TOKEN=your-auth-service-token

# Git Settings
GIT_REPO_BASE_PATH=/tmp/f_operator_repos
GIT_DEFAULT_REMOTE=origin
GIT_SSH_KEY_PATH=/path/to/ssh/key
GIT_ACCESS_TOKEN=your-git-access-token

# AI Platform Settings
HUGGINGFACE_API_TOKEN=your-huggingface-token
SAGEMAKER_ROLE_ARN=your-sagemaker-role

# Integration Service URLs
AGENT_REGISTRY_URL=http://localhost:8000
AGENT_REGISTRY_TOKEN=your-agent-registry-token
POLICY_ENGINE_URL=http://localhost:9000
POLICY_ENGINE_TOKEN=your-policy-engine-token

# Database Settings
POSTGRES_SERVER_F=localhost
POSTGRES_USER_F=postgres
POSTGRES_PASSWORD_F=password
POSTGRES_DB_F=kfm_f_operator_db
POSTGRES_PORT_F=5432
# SQLALCHEMY_DATABASE_URI_F=postgresql+asyncpg://user:password@localhost:5432/dbname
