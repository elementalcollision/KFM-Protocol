# Application Settings
PROJECT_NAME="KFM K Operator Service"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Grace Periods (ISO 8601 duration format)
DEFAULT_DEPRECATION_GRACE_PERIOD_ISO=P30D  # 30 days
DEFAULT_ARCHIVAL_RETENTION_PERIOD_ISO=P90D  # 90 days

# Service Dependencies
AGENT_REGISTRY_URL=http://localhost:8000/api/v1

# Security Settings
SECRET_KEY=your-secret-key-that-should-be-changed-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional Database Settings (if needed)
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=kfm_k_operator_db
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@localhost:5432/kfm_k_operator_db 