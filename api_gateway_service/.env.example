# API Gateway Service Configuration

# API Info
API_TITLE="KFM-AE API Gateway"
API_VERSION="1.0"
API_PREFIX="/api/v1"

# Backend Service URLs
AGENT_REGISTRY_URL="http://localhost:8001"
F_OPERATOR_URL="http://localhost:8002"
M_OPERATOR_URL="http://localhost:8003"
K_OPERATOR_URL="http://localhost:8004"

# HTTP Client Configuration
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5
HTTP_RETRY_STATUS_CODES="408,429,500,502,503,504"

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_DEFAULT_TTL=60

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1

# Logging
LOG_LEVEL="INFO"

# CORS Settings
CORS_ALLOW_ORIGINS="*"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# Server Configuration
PORT=8000
HOST="0.0.0.0"

# Comma-separated list of valid API keys for authentication
API_KEYS=supersecretkey 